# HESYD ONE — Variables d'environnement
# Copier vers .env puis compléter. Les secrets vivent UNIQUEMENT côté serveur.

# ————— Base de données —————
# Sandbox : SQLite (db/custom.db). Production : Neon PostgreSQL (décision imposée).
DATABASE_URL=file:./db/custom.db
# DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require   # Neon

# ————— URLs canoniques (OAuth callbacks, webhooks) —————
APP_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# ————— Google (connexion OAuth + Drive API) —————
# Console Google Cloud → Identifiants → ID client OAuth (application Web)
# Redirect URI de connexion : {APP_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/drive/callback
# Clé de chiffrement des jetons Drive et secrets TOTP (32+ caractères aléatoires)
DRIVE_ENCRYPTION_KEY=

# ————— Google Document AI (OCR — décision imposée) —————
# Console Google Cloud → Document AI → Processor (OCR) : project / location / processor ID
GOOGLE_DOC_AI_PROJECT=
GOOGLE_DOC_AI_LOCATION=
GOOGLE_DOC_AI_PROCESSOR_ID=
# Authentification : compte de service complet (JSON) OU un access token court — jamais les deux requis
GOOGLE_SERVICE_ACCOUNT_JSON=
DOC_AI_ACCESS_TOKEN=

# ————— Meta WhatsApp Cloud API —————
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ————— Polar (paiements et abonnements — décision imposée) —————
# Dashboard Polar → Settings → API keys (access token) ; Webhooks → secret du endpoint
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# IDs des produits Polar par offre (Dashboard → Products → Copy Product ID)
POLAR_PRODUCT_ID_STANDARD=
POLAR_PRODUCT_ID_ENTREPRISE=

# ————— Resend (e-mails transactionnels — décision imposée) —————
RESEND_API_KEY=
RESEND_FROM=

# ————— Azure AI Foundry (fournisseur de modèle IA de production) —————
# https://{resource}.openai.azure.com — déploiement chat, clé API, version d'API data plane
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_KEY=
AZURE_AI_FOUNDRY_DEPLOYMENT=
AZURE_AI_FOUNDRY_API_VERSION=2024-10-21

# ————— Console plateforme (e-mails opérateurs, séparés par virgules) —————
PLATFORM_ADMIN_EMAILS=

# ————— n8n (orchestration, reprise) —————
N8N_BASE_URL=
N8N_SHARED_SECRET=
