    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Transfert du corps BRUT de Meta (octet pour octet — sa signature\n// X-Hub-Signature-256 doit rester valide côté HESYD) + construction de la\n// signature du contrat HESYD (src/lib/connectors/n8n.ts, CDC §13.4).\n// Aucun secret ici : le secret partagé est lu par le nœud Crypto via $env.\nconst out = [];\nfor (const item of $input.all()) {\n  const json = item.json || {};\n  const rawBody = json.rawBody !== undefined ? String(json.rawBody) : JSON.stringify(json.body || {});\n  const headers = json.headers || {};\n  const metaSignature = String(headers['x-hub-signature-256'] || '');\n  const timestamp = Date.now().toString();\n  const correlationId = 'n8n-wa-' + timestamp + '-' + Math.random().toString(36).slice(2, 10);\n  out.push({ json: { rawBody: rawBody, metaSignature: metaSignature, timestamp: timestamp, correlationId: correlationId, stringToSign: timestamp + '.' + rawBody } });\n}\nreturn out;"
      },
      "id": "27fb0918-a3ce-4dd1-9ee8-67b192035411",
      "name": "Transfert signé",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-420, 80]
    },
    {
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "secret": "={{ $env.N8N_SHARED_SECRET }}",
        "value": "={{ $json.stringToSign }}",
        "encoding": "hex"
      },
      "id": "38ac12a9-b4df-4ee2-8ff9-78c292036522",
      "name": "Signature HMAC",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
